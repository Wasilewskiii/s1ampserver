Meta.DisplayName=Schedule I Dedicated Server (S1DS)
Meta.Description=Schedule I dedicated server via the S1DedicatedServers mod, running the official Docker image (Wine + MelonLoader + SteamCMD baked in). Requires Docker on the host and a Steam account that owns Schedule I.
Meta.OS=Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=Marcel Wasilewski (wraps ifBars/S1DedicatedServers)
Meta.URL=https://github.com/ifBars/S1DedicatedServers
Meta.DisplayImageSource=steam:3164500
Meta.EndpointURIFormat=
Meta.ConfigManifest=schedule1-s1dsconfig.json
Meta.MetaConfigManifest=schedule1-s1dsmetaconfig.json
Meta.ConfigRoot=schedule1-s1ds.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=NotSupported
Meta.ContainerPolicyReason=This application launches the official S1DS Docker image itself, so the AMP instance must run directly on the host with access to the Docker daemon. Do not create this instance inside a container.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=4
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=3e0704cc-a132-44e5-9c0b-0685502c24c2
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False
App.DisplayName=Schedule I Dedicated Server
App.RootDir=./s1ds/
App.BaseDirectory=./s1ds/game/
App.ExecutableWin=
App.ExecutableLinux=/usr/bin/docker
App.WorkingDir=
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=run --rm -i --name s1ds-server --stop-timeout 60 --env-file {{$FullRootDir}}s1ds.env -p {{$GamePort}}:{{$GamePort}}/udp -p {{$StatusPort}}:38465/tcp -p {{$QueryPort}}:{{$QueryPort}}/udp -v {{$FullRootDir}}game:/home/steam/game -v {{$FullRootDir}}steamcmd:/home/steam/steamcmd -v {{$FullRootDir}}steamhome:/home/steam/Steam ghcr.io/ifbars/s1dedicatedservers:{{ImageTag}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=-{0}={1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=90
App.ExitString=stop
App.ExitFile=app_exit.lck
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[schedule1-s1dsports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=GamePort
App.UniversalSleepApplicationUDPPortRef=0
App.ApplicationReadyMode=RegexMatch
App.ExitTimeoutSeconds=90
App.TelnetLoginFormat={0}
App.UpdateSources=@IncludeJson[schedule1-s1dsupdates.json]
App.PreStartStages=@IncludeJson[schedule1-s1dsprestart.json]
App.ForceUpdate=False
App.RapidStartup=False
App.MonitorChildProcessName=
App.SupportsUniversalSleep=False
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=^(_XSERVTrans.*|The XKEYBOARD keymap compiler.*|> Warning:\s+Could not resolve keysym.*|Errors from xkbcomp are not fatal.*|[0-9a-f]{2,6}:(fixme|warn):.*|libEGL warning:.*|ALSA lib .*)$
Console.AppReadyRegex=\[DedicatedServerHost\] === DEDICATED SERVER READY
Console.UserJoinRegex=\[DedicatedServerHost\] Player joined: (?<username>.+?) \(ClientId [1-9]\d*\)
Console.UserLeaveRegex=\[DedicatedServerHost\] Starting auto save: player_left_(?<username>[^\x1b]+)
Console.UserChatRegex=
Console.MetricsRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.AutoRetryCount=2
